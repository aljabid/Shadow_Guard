{
  "title": "ShadowGuard Platform Overview",
  "uid": "shadowguard-main",
  "version": 1,
  "schemaVersion": 30,
  "style": "dark",
  "tags": ["shadowguard", "afm", "security"],
  "panels": [
    {
      "id": 1,
      "title": "Total Alerts (24h)",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "rawSql": "SELECT COUNT(*) FROM alerts WHERE created_at > NOW() - INTERVAL '24 hours'",
          "format": "table"
        }
      ]
    },
    {
      "id": 2,
      "title": "Critical Alerts (24h)",
      "type": "stat",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "rawSql": "SELECT COUNT(*) FROM alerts WHERE severity = 'critical' AND created_at > NOW() - INTERVAL '24 hours'",
          "format": "table"
        }
      ]
    },
    {
      "id": 3,
      "title": "Modules Run (24h)",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "rawSql": "SELECT COUNT(*) FROM module_tasks WHERE created_at > NOW() - INTERVAL '24 hours'",
          "format": "table"
        }
      ]
    },
    {
      "id": 4,
      "title": "Cross-Module Entities",
      "type": "stat",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "rawSql": "SELECT COUNT(*) FROM shared_entities WHERE array_length(source_modules, 1) > 1",
          "format": "table"
        }
      ]
    },
    {
      "id": 5,
      "title": "Alerts by Module (24h)",
      "type": "piechart",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "rawSql": "SELECT module_id, COUNT(*) as count FROM alerts WHERE created_at > NOW() - INTERVAL '24 hours' GROUP BY module_id",
          "format": "table"
        }
      ]
    },
    {
      "id": 6,
      "title": "Alert Timeline (7d)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "rawSql": "SELECT date_trunc('hour', created_at) as time, COUNT(*) as alerts FROM alerts WHERE created_at > NOW() - INTERVAL '7 days' GROUP BY 1 ORDER BY 1",
          "format": "time_series"
        }
      ]
    }
  ],
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "30s"
}
