# ── Application ─────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=ShadowGuard
APP_VERSION=1.0.0
SECRET_KEY=change-this-to-a-random-32-char-string-minimum
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALLOWED_ORIGINS=["http://localhost:3000"]

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=shadowguard
POSTGRES_PASSWORD=shadowguard_dev_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=shadowguard

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Elasticsearch ────────────────────────────────────────────────────────────
ELASTICSEARCH_URL=http://elasticsearch:9200

# ── MinIO ────────────────────────────────────────────────────────────────────
MINIO_USER=shadowguard
MINIO_PASSWORD=shadowguard_minio_dev
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=evidence-packages

# ── Telegram API ─────────────────────────────────────────────────────────────
# Get from https://my.telegram.org
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash
TELEGRAM_SESSION_STRING=your_session_string

# ── Blockchain APIs ──────────────────────────────────────────────────────────
# TronGrid: https://www.trongrid.io (free tier available)
TRONGRID_API_KEY=your_trongrid_api_key
# Etherscan: https://etherscan.io/apis (free tier available)
ETHERSCAN_API_KEY=your_etherscan_api_key

# ── Kazakhstan Registries ────────────────────────────────────────────────────
AIFC_API_KEY=
EGOV_API_KEY=
